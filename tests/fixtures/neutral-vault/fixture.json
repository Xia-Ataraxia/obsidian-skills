        "note": "An out-of-enum property type is the validator's one enumerated rejection.",
        "text": "{\n  \"name\": \"Bad Type\",\n  \"behavior\": \"create\",\n  \"noteNameFormat\": \"{{title}}\",\n  \"path\": \"Clippings\",\n  \"noteContentFormat\": \"{{content}}\",\n  \"properties\": [\n    {\n      \"name\": \"tags\",\n      \"value\": \"clippings\",\n      \"type\": \"tags\"\n    }\n  ]\n}\n",
        "expect_defect_code": "property.invalid-type"
      },
      {
        "id": "context-not-string",
        "note": "context must be a string when present.",
        "text": "{\n  \"name\": \"Numeric Context\",\n  \"behavior\": \"create\",\n  \"noteNameFormat\": \"{{title}}\",\n  \"path\": \"Clippings\",\n  \"noteContentFormat\": \"{{content}}\",\n  \"properties\": [],\n  \"context\": 7\n}\n",
        "expect_defect_code": "template.context-not-string"
      }
    ]
  },
  "doctor": {
    "evidence_schema": "obsidian-doctor/evidence@1",
    "bundles": [
      {
        "id": "optional-channels-absent",
        "note": "Only the runtime channel is supplied: every optional channel must report not_applicable rather than being invented.",
        "bundle": {
          "schema": "obsidian-doctor/evidence@1",
          "case_id": "neutral-001",
          "runtime": {
            "app_running": true,
            "cli_available": true,
            "app_version": "1.9.1",
            "cli_commands_confirmed": [
              "dev:errors"
            ]
          }
        },
        "expect": {
          "check_status": {
            "runtime-unavailable": "ruled_out",
            "plugin-unavailable": "not_applicable",
            "templater-reference-error": "not_applicable",
            "fixture-not-sanitized": "ruled_out"
          }
        }
      },
      {
        "id": "plugin-channel-present-but-unobserved",
        "note": "The plugin channel exists but its state was never observed: the check must stay unknown instead of assuming availability.",
        "bundle": {
          "schema": "obsidian-doctor/evidence@1",
          "case_id": "neutral-002",
          "runtime": {
            "app_running": true,
            "cli_available": true,
            "app_version": "1.9.1"
          },
          "plugin": {
            "id": "templater-obsidian"
          }
        },
        "expect": {
          "check_status": {
            "plugin-unavailable": "unknown"
          },
          "expect_indeterminate": true
        }
      },
      {
        "id": "plugin-channel-observed-available",
        "note": "Install and enable state explicitly observed as true.",
        "bundle": {
          "schema": "obsidian-doctor/evidence@1",
          "case_id": "neutral-003",
          "runtime": {
            "app_running": true,
            "cli_available": true,
            "app_version": "1.9.1"
          },
          "plugin": {
            "id": "templater-obsidian",
            "installed": true,
            "enabled": true,
            "manifest": {
              "id": "templater-obsidian",
