{
	"schemaVersion": "0.1.0",
	"name": "General clipping",
	"behavior": "create",
	"noteContentFormat": "> [!quote] Source\n> {{site ?? domain}}{% if author %} · {{author}}{% endif %}{% if published %} · {{published|date:\"YYYY-MM-DD\"}}{% endif %}\n> {{url}}\n\n{% if description %}{{description|blockquote}}\n\n{% endif %}{% if highlights %}## Highlights\n\n{{highlights|map: item => item.text|join:\"\\n\\n\"}}\n\n{% endif %}## Notes\n\n## Source text\n\n{{content}}\n",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\", \"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "site",
			"value": "{{site ?? domain}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "words",
			"value": "{{words}}",
			"type": "number"
		},
		{
			"name": "topics",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "tags",
			"value": "clippings",
			"type": "multitext"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title|safe_name ?? \"Untitled\"}}",
	"path": "Clippings"
}
